# ---------------------------------------------------------------------------
# AI Video Agent - environment configuration template
# Copy this file to ".env" and fill in real values.
# NEVER commit a .env file containing real secrets.
# ---------------------------------------------------------------------------

# --- Application ---
APP_ENV=development
APP_NAME=ai-video-agent
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# --- Database (SQLite by default; switch to PostgreSQL URL later) ---
DATABASE_URL=sqlite:///./data/ai_video_agent.db

# --- LLM providers ---
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=

# --- Map / geocoding provider ---
# GEO_PROVIDER: none | osm | google
# - "none": no geocoding (locations stay unresolved — never fabricated)
# - "osm": OpenStreetMap Nominatim (free, no key required)
# - "google": Google Maps Geocoding API (requires GOOGLE_MAPS_API_KEY)
GEO_PROVIDER=none
GOOGLE_MAPS_API_KEY=
NOMINATIM_URL=https://nominatim.openstreetmap.org/search

# --- FFmpeg ---
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# --- Video defaults ---
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=30

# --- Paths (relative to project root unless absolute) ---
DATA_DIR=./data
ASSETS_DIR=./assets
SOUNDS_DIR=./sounds
OUTPUT_DIR=./output
LOGS_DIR=./logs
TEMP_DIR=./temp
